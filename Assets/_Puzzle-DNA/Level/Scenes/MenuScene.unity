MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1213945466}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 036184d6f6f92be49a3e4ab16eb485e6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  en: 'In the last few days, Aiden has been acting strangely and uncontrollably.
    Prof. Woo suspects that there is an error in the combination of Atomic DNA which
    if not handled immediately will have an impact and spread to all Aiden in the
    world. '
  id: 'Beberapa hari terakhir, Aiden bertingkah aneh dan tidak terkendali. Prof.
    Woo menduga terjadi error dalam kombinasi DNA Atom, jika tidak segera ditangani
    akan berdampak dan menjalar pada seluruh Aiden di dunia. '
  my: 'Beberapa hari terakhir, Aiden bertingkah aneh dan tidak terkendali. Prof.
    Woo menduga terjadi error dalam kombinasi DNA Atom, jika tidak segera ditangani
    akan berdampak dan menjalar pada seluruh Aiden di dunia. '
  enEvent:
    m_PersistentCalls:
      m_Calls: []
  idEvent:
    m_PersistentCalls:
      m_Calls: []
  myEvent:
    m_PersistentCalls:
      m_Calls: []
