        animPrefab: {fileID: 0}
        contentEn: Yes, I am. Who are you? How do you know me?
        contentId: Benar sekali, Siapa kamu? Dari mana kamu mengenalku?
        contentMy: Benar sekali, Siapa kamu? Dari mana kamu mengenalku?
    - playerIsTalking: 1
      contentData:
        playerExpression: 2
        interlocutorSprite: {fileID: 21300000, guid: 5a24df4841c57fe45a6ca02a86d07948,
          type: 3}
        clipCodeEn: 11.4-en
        clipCodeId: 11.4-id
        clipCodeMy: 11.4-my
        clipEn: {fileID: 0}
        clipId: {fileID: 0}
        clipMy: {fileID: 0}
        bgmClip: {fileID: 0}
        animPrefab: {fileID: 0}
        contentEn: I'm the fellow adventure, I recognize you from my history book.
          I admire you!
        contentId: Aku adalah teman petualang, aku mengenalmu dari buku sejarahku.
          Aku mengagumimu!
        contentMy: Aku adalah teman petualang, aku mengenalmu dari buku sejarahku.
          Aku mengagumimu!
    - playerIsTalking: 0
      contentData:
        playerExpression: 2
        interlocutorSprite: {fileID: 21300000, guid: 5a24df4841c57fe45a6ca02a86d07948,
          type: 3}
