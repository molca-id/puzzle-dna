    descriptionValue:
      playerExpression: 0
      interlocutorSprite: {fileID: 0}
      clipCodeEn: 
      clipCodeId: 
      clipCodeMy: 
      clipEn: {fileID: 0}
      clipId: {fileID: 0}
      clipMy: {fileID: 0}
      bgmClip: {fileID: 0}
      animPrefab: {fileID: 0}
      contentEn: 'Abilities you can receive from collecting 25 points in ATOM DNA
        each in "D" or "N" or "A" : D: If you manages to solve 4 D icon match, you
        will receive the ability "Drive" where your score are multiplied by 4. N: 
        If you manages to solve 4 N icon match, you will receive the ability "Network"
        (Rocket Icon Match), where the + rows becomes auto solve. A: If you manages
        to solve 4 A icon match, you will receive the ability "Action" (Bomb Icon
        Match), will cause a 6x6 tile explosion'
      contentId: "Ability yang dapat didapatkan dengan mengumpulkan minimal 25 poin
        di ATOM DNA di masing total di \u201CD\u201D atau \u201CN\u201D atau \u201CA\u201D
        :\r\nD =  Jika berhasil mensolve 4 D icon match maka akan mendapat ability
        \u201CDrive\u201D dimana score menjadi 4x\r\nN = Jika berhasil mensolve 4
        N icon match maka akan mendapat ability \u201CNetwork\u201D (Roket Icon Match)
        dimana baris \u201C + \u201C akan auto solve\r\nA = = Jika berhasil mensolve
        4 A icon match maka akan mendapat ability \u201CAction\u201D (Bom Icon Match)
        dimana akan terjadi ledakan \u201C6x6\u201D "
      contentMy: "Ability yang dapat didapatkan dengan mengumpulkan minimal 25 poin
        di ATOM DNA di masing total di \u201CD\u201D atau \u201CN\u201D atau \u201CA\u201D
        :\r\nD =  Jika berhasil mensolve 4 D icon match maka akan mendapat ability
        \u201CDrive\u201D dimana score menjadi 4x\r\nN = Jika berhasil mensolve 4
        N icon match maka akan mendapat ability \u201CNetwork\u201D (Roket Icon Match)
        dimana baris \u201C + \u201C akan auto solve\r\nA = = Jika berhasil mensolve
        4 A icon match maka akan mendapat ability \u201CAction\u201D (Bom Icon Match)
        dimana akan terjadi ledakan \u201C6x6\u201D "
