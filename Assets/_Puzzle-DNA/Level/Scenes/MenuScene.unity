  - name: Kemampuan
    titleValue:
      playerExpression: 0
      interlocutorSprite: {fileID: 0}
      clipCodeEn: 
      clipCodeId: 
      clipCodeMy: 
      clipEn: {fileID: 0}
      clipId: {fileID: 0}
      clipMy: {fileID: 0}
      bgmClip: {fileID: 0}
      animPrefab: {fileID: 0}
      contentEn: Ability
      contentId: Kemampuan
      contentMy: Kemampuan
    descriptionValue:
      playerExpression: 0
      interlocutorSprite: {fileID: 0}
      clipCodeEn: 
      clipCodeId: 
      clipCodeMy: 
      clipEn: {fileID: 0}
      clipId: {fileID: 0}
      clipMy: {fileID: 0}
      bgmClip: {fileID: 0}
      animPrefab: {fileID: 0}
      contentEn: 'Abilities you can receive from solving 4 D, N, or A Puzzles, :
        D: If you manages to solve 4 D icon match, you will receive the ability "Drive"
        where your score are multiplied by 2. N:  If you manages to solve 4 N icon
        match, you will receive the ability "Network" (Rocket Icon Match), where
        the - rows becomes auto solve. A: If you manages to solve 4 A icon match,
        you will receive the ability "Action" (Bomb Icon Match), will cause a 3x3
        tile explosion'
      contentId: "Kemampuan yang didapatkan ketika bermain, dimana ketika mensolve
        puzzle 4 D,N atau A.\r\nD = Jika berhasil mensolve 4 D icon match maka akan
        mendapat ability \u201CDrive\u201D dimana score menjadi 2x \r\nN =Jika berhasil
        mensolve 4 N icon match maka akan mendapat ability \u201CNetwork\u201D (Roket
        Icon Match) dimana baris \u201C - \u201C akan auto solve\r\nA = Jika berhasil
        mensolve 4 A icon match maka akan mendapat ability \u201CAction\u201D (Bom
        icon match) dimana akan terjadi ledakan \u201C3x3\u201D"
      contentMy: "Kemampuan yang didapatkan ketika bermain, dimana ketika mensolve
        puzzle 4 D,N atau A.\r\nD = Jika berhasil mensolve 4 D icon match maka akan
        mendapat ability \u201CDrive\u201D dimana score menjadi 2x \r\nN =Jika berhasil
        mensolve 4 N icon match maka akan mendapat ability \u201CNetwork\u201D (Roket
        Icon Match) dimana baris \u201C - \u201C akan auto solve\r\nA = Jika berhasil
        mensolve 4 A icon match maka akan mendapat ability \u201CAction\u201D (Bom
        icon match) dimana akan terjadi ledakan \u201C3x3\u201D"
